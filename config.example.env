# Copy to config.env: the one file for settings AND secrets (gitignored, mode 600).
# Add secrets with: ff login <KEY>   (hidden input, written here) Generic: any git repo, any agent CLI. Tracker adapter in tracker/.
TRACKER=clickup                 # tracker/<name>.sh
CLICKUP_TOKEN=pk_xxx            # ff whoami prints the two ids below
CLICKUP_TEAM_ID=
CLICKUP_USER_ID=
CLICKUP_LIST_ID=                # optional: only this list

REPO=/path/to/your/repo         # default: current directory. Server: leave out (docker-compose sets it)
BASE=main                       # branch PRs target and worktrees start from
GH_REPO=                        # owner/name, only if gh cannot infer it from the remote
SETUP_CMD=                      # run once in each new worktree, e.g. "npm ci"
VERIFY_CMD=                     # e.g. "npm test". Agents run it, and the factory runs it itself as a gate after the coder and each fix


# Tracker statuses (state machine). Names must exist in your tracker.
S_TODO="to do"
S_SPEC_REVIEW="spec review"
S_APPROVED="approved"
S_WORKING="in progress"
S_IN_REVIEW="in review"
S_BLOCKED="blocked"

SPEC_GATE=1                     # 1 = human approves the spec before coding
AUTO_PICKUP=0                   # 0 = manual only (run / poll --now). 1 = schedule may pick up tickets.
MAX_REVIEW_ROUNDS=2
MAX_PER_RUN=1                   # tickets one poll takes
AGENT_TIMEOUT=3600

# Tickets in parallel. Each ticket runs in its own git worktree and cell (cell.sh): own branch,
# run folder, port range and compose project; its agents cannot change other tickets' refs.
MAX_PARALLEL=1                  # the daemon runs this many tickets at once
SLOTS=8                         # cells on this machine (manual `ff run`s count too)
CELL_PORT_START=20000           # cell N gets ports CELL_PORT_START + N*CELL_PORT_SPAN, exported as PORT_BASE and PORT
CELL_PORT_SPAN=100
CACHE_VOLUME=factory-cache      # docker sandbox: package downloads shared by all worktrees. Empty = off.

TYPESAFE_API_KEY=               # optional Jev key: hard tickets skip the cheapest models

# Sandbox: docker = every agent step runs in its own throwaway container (build the image once:
# docker build -t software-factory .). none = agents run directly on this machine.
SANDBOX=docker
SANDBOX_IMAGE=software-factory
SANDBOX_ARGS=                   # extra docker run flags, e.g. "--cpus 2 --memory 6g"
# Where agent CLI login files live (~/.codex/auth.json, ~/.pi/agent/auth.json, ...). They are
# mounted into each sandbox and read by the router for quota. API keys: ff login <KEY>
AUTH_HOME=$HOME
# Where you watch agents: auto (Herdr panes when run inside Herdr, else headless), headless, herdr
DISPLAY_UI=auto

# Server (docker compose) only. The server reads this same file from its data folder:
GH_TOKEN=                       # GitHub token that can push branches and open PRs
GIT_USER_NAME=
GIT_USER_EMAIL=

# Label put on every PR the factory opens (created if missing). Empty = no label.
PR_LABEL="created by agent-shiv"
# Skills search path, first match wins. Default: ./skills, ~/.agents/skills, ~/.claude/skills, ~/.codex/skills, ~/.pi/agent/skills
# SKILLS_PATH=

# Observability: send every ticket run as an OpenTelemetry trace. Empty = off.
# LangSmith: OTEL_EXPORTER_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
#            OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<key>,Langsmith-Project=software-factory
# Local Jaeger: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Dashboard database: a local MySQL container. `ff db up` creates it and sets both lines below.
DB=                             # mysql = store every run
DB_PASSWORD=

# ff gc (and the daemon, daily): remove worktrees and log lines idle this many days
GC_DAYS=14

# 1 = post the spec, failures and PR links as ticket comments. 0 (default) = never comment on tickets.
TRACKER_COMMENTS=0
