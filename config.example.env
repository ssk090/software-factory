# Copy to config.env: the one file for settings AND secrets (gitignored, mode 600). ff sources it.
# Add secrets with: ff login <KEY>   (hidden input, written here)

# ---- Tracker: ClickUp ----
CLICKUP_TOKEN=pk_xxx            # ff whoami prints the two ids below
CLICKUP_TEAM_ID=
CLICKUP_USER_ID=
CLICKUP_LIST_ID=                # optional: auto pickup takes tickets from this list only
# Your sprint on the dashboard (tasks assigned to you). Either the Sprints folder (the sprint whose
# dates cover today is used) or one sprint list:
CLICKUP_SPRINT_FOLDER_ID=
CLICKUP_SPRINT_LIST_ID=
CLICKUP_ID_PREFIX=              # your custom task id prefix (CHP): then a bare number such as 7642 means CHP-7642

# Tracker statuses (state machine). Names must exist in your lists.
S_TODO="to do"
S_SPEC_REVIEW="spec review"
S_APPROVED="approved"
S_WORKING="in progress"
S_IN_REVIEW="in review"
S_BLOCKED="blocked"

# ---- Production issues: Sentry ----
SENTRY_AUTH_TOKEN=              # a token with event:read (ff login SENTRY_AUTH_TOKEN)
SENTRY_ORG=                     # organization slug
SENTRY_PROJECTS=                # comma-separated project ids (Settings > Projects); empty = every project you can see
SENTRY_ENVIRONMENT=production    # one or more, comma-separated: prod,production
SENTRY_URL=https://sentry.io    # or your region (https://us.sentry.io) or self-hosted Sentry
SENTRY_QUERY=is:unresolved
SENTRY_PERIOD=14d
SENTRY_POLL_INTERVAL=900        # seconds between syncs (the dashboard also has "Sync now")
SENTRY_MAX_PAGES=5              # 100 issues per page
SENTRY_CLICKUP_LIST_ID=         # where "Fix this" creates the ticket; default CLICKUP_LIST_ID

# ---- The repo ----
REPO=/path/to/your/repo         # default: current directory. Server: leave out (docker-compose sets it)
BASE=main                       # branch PRs target and worktrees start from
GH_REPO=                        # owner/name, only if gh cannot infer it from the remote
SETUP_CMD=                      # run once in each new worktree, e.g. "npm ci"
VERIFY_CMD=                     # e.g. "npm test". The factory runs it itself as a gate after the coder and each fix

# ---- Models: the agents run on pi-ai, with the provider's API key ----
ANTHROPIC_API_KEY=              # ff login ANTHROPIC_API_KEY
OPENAI_API_KEY=                 # a second provider lets code be reviewed by another model family
# LANES_FILE=                   # default durable/lanes.json: which model each agent role runs on

# ---- Pipeline ----
SPEC_GATE=1                     # 1 = the pipeline waits for you to approve the spec before coding
AUTO_PICKUP=0                   # 1 = every POLL_INTERVAL, start tickets assigned to you in S_TODO / S_APPROVED
POLL_INTERVAL=3600
MAX_REVIEW_ROUNDS=2
AGENT_TIMEOUT=3600              # seconds one agent step may take
MAX_PARALLEL=1                  # tickets that run at once, each in its own worktree and cell
SLOTS=8                         # cells on this machine
CELL_PORT_START=20000           # cell N gets ports CELL_PORT_START + N*CELL_PORT_SPAN, as PORT_BASE and PORT
CELL_PORT_SPAN=100
GC_DAYS=14                      # ff gc: worktrees idle this many days are removed
PR_LABEL="created by agent-shiv"   # label put on every PR the factory opens (created if missing). Empty = none
TRACKER_COMMENTS=0              # 1 = post the spec, failures and PR links as ticket comments
TRACKER_ATTACH=1                # attach the spec and plan to the ticket as <ticket>-spec.md and <ticket>-plan.md
STE_ROLES=spec,plan             # agents that write in Simplified Technical English (ASD-STE100); empty: none
# SKILLS_PATH=                  # default: ./skills, ~/.agents/skills, ~/.claude/skills, ~/.codex/skills, ~/.pi/agent/skills

# ---- Model API use: per provider (one API key each); 0 = no limit ----
RATE_LIMIT_RPM=50               # requests a minute; more wait for the window
RATE_LIMIT_TPM=0                # tokens a minute (e.g. your provider tier's limit)
DAILY_BUDGET_USD=0              # spend per day at catalog prices; when reached, running tickets pause until tomorrow

# ---- Sandbox ----
# docker = each ticket's agent commands run in its own container of SANDBOX_IMAGE
#          (docker build -t software-factory .). none = they run on this machine.
SANDBOX=docker
SANDBOX_IMAGE=software-factory
SANDBOX_ARGS=                   # extra docker run flags, e.g. "--cpus 2 --memory 6g"
CACHE_VOLUME=factory-cache      # package downloads shared by all ticket containers. Empty = off

# ---- Dashboard (ff serve) ----
DASH_HOST=127.0.0.1             # another address needs DASH_PASSWORD (basic auth)
DASH_PORT=8090
DASH_PASSWORD=
DASH_ALLOWED_HOSTS=             # extra Host names allowed, comma-separated (e.g. a tunnel's name)

# ---- Server (docker compose) only ----
GH_TOKEN=                       # GitHub token that can push branches and open PRs
GIT_USER_NAME=
GIT_USER_EMAIL=
